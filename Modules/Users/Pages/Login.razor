@page "/login"
@layout InvoiceBuilder.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject IWebHostEnvironment Env

<PageTitle>Sign in — InvoiceBuilder</PageTitle>

<main class="relative w-full max-w-sm">
    <div class="pointer-events-none absolute inset-x-0 -top-48 -z-10 flex justify-center" aria-hidden="true">
        <div class="h-80 w-80 rounded-full bg-brand-200/50 blur-3xl"></div>
        <div class="h-80 w-80 -translate-x-24 translate-y-12 rounded-full bg-violet-200/40 blur-3xl"></div>
    </div>

    <div class="mb-6 flex flex-col items-center gap-3">
        <span class="brand-mark h-12 w-12 rounded-2xl text-lg shadow-md shadow-brand-600/20">IB</span>
        <span class="text-lg font-bold tracking-tight text-slate-900">Invoice<span class="text-brand-600">Builder</span></span>
    </div>

    <div class="card overflow-hidden shadow-xl ring-1 ring-slate-900/5">
        <div class="px-6 py-8 sm:px-8">
            <div class="text-center">
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Welcome back</h1>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-500">Sign in to manage senders, customers &amp; invoices.</p>
            </div>

            <form method="post" action="Account/PerformExternalLogin" class="mt-7">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <button type="submit" name="provider" value="Google" class="btn-secondary w-full gap-2.5 py-2.5 font-semibold text-slate-800">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="h-4 w-4 shrink-0" aria-hidden="true">
                        <path fill="#ea4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285f4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#fbbc05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34a853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                    Sign in with Google
                </button>
            </form>

            <p class="mt-5 text-center text-xs leading-relaxed text-slate-400">
                By signing in, you agree to use this tool in line with your company's policies.
            </p>
        </div>

        @if (Env.IsDevelopment())
        {
            <div class="border-t border-dashed border-slate-200 bg-slate-50/80 px-6 py-4 sm:px-8">
                <p class="text-center text-[11px] font-semibold tracking-wide text-slate-400 uppercase">Development only</p>
                <form method="post" action="Account/DevSignIn" class="mt-2.5">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-secondary w-full py-2 text-xs text-slate-500">
                        Continue as @DevAuthEndpoints.TestUserEmail
                    </button>
                </form>
            </div>
        }
    </div>

    <p class="mt-6 flex items-center justify-center gap-1.5 text-center text-xs text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7V4.5A3.5 3.5 0 0 0 8 1Zm2 6V4.5a2 2 0 1 0-4 0V7h4Z" clip-rule="evenodd" />
        </svg>
        Sign in with any Google account.
    </p>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
