@namespace InvoiceBuilder.Modules.Invoices.Components

<div class="card overflow-hidden">
    <div class="border-b border-slate-100 px-5 py-4">
        <h3 class="text-sm font-semibold tracking-wide text-slate-900">Summary</h3>
    </div>
    <dl class="space-y-2.5 px-5 py-4 text-sm">
        <div class="flex justify-between">
            <dt class="text-slate-500">Subtotal</dt>
            <dd class="font-medium text-slate-700">@Invoice.Subtotal.ToString("N2") @Invoice.Currency</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-slate-500">Tax Rate</dt>
            <dd class="font-medium text-slate-700">@Invoice.TaxRate.ToString("N2")%</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-slate-500">Tax</dt>
            <dd class="font-medium text-slate-700">@Invoice.TaxAmount.ToString("N2") @Invoice.Currency</dd>
        </div>
    </dl>
    <div class="flex items-center justify-between bg-slate-50 px-5 py-4">
        <span class="text-sm font-semibold text-slate-900">Total Amount</span>
        <span class="text-lg font-bold text-indigo-600">@Invoice.Total.ToString("N2") @Invoice.Currency</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Invoice Invoice { get; set; } = null!;
}
