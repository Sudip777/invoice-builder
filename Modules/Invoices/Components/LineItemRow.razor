@namespace InvoiceBuilder.Modules.Invoices.Components

<div class="flex items-center gap-3">
    <input @bind="Item.Description" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="Item description"
           class="form-input mt-0 flex-1" />

    <MudNumericField T="decimal" @bind-Value="Item.Quantity" @bind-Value:after="NotifyChanged" Min="0" Format="N2"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="w-24" />

    <MudNumericField T="decimal" @bind-Value="Item.UnitPrice" @bind-Value:after="NotifyChanged" Min="0" Format="N2"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="w-28" />

    <div class="w-28 shrink-0 text-right text-sm font-semibold text-slate-800">
        @Item.LineTotal.ToString("N2")
    </div>

    <div class="flex w-14 shrink-0 justify-end">
        <button type="button" @onclick="Remove" title="Remove item"
                class="rounded-lg p-1.5 text-slate-400 transition hover:bg-red-50 hover:text-red-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public InvoiceLineItem Item { get; set; } = null!;
    [Parameter] public EventCallback OnRemove { get; set; }

    // Item is a reference shared with the parent's LineItems list, so mutating it here
    // doesn't re-render the parent (and its sibling InvoiceSummary) automatically —
    // bubble a notification up so the parent can refresh the live totals.
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task Remove() => await OnRemove.InvokeAsync();
    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}
