@page "/invoices/{Id:int}"
@inject InvoiceService InvoiceSvc
@inject NavigationManager Nav

<PageTitle>@(_invoice?.InvoiceNumber ?? "Invoice") · Invoice Builder</PageTitle>

@if (_invoice is null)
{
    <p class="text-sm text-slate-500">Loading…</p>
}
else
{
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <a href="/invoices" class="back-link">&larr; Back to Invoices</a>
        <div class="flex gap-3">
            <a href="@($"/invoices/{Id}/edit")" class="btn-secondary flex-1 sm:flex-none">Edit</a>
            <a href="@($"/invoices/{Id}/pdf")" target="_blank" class="btn-primary flex-1 sm:flex-none">Download PDF</a>
        </div>
    </div>

    <div class="card mx-auto mt-6 max-w-3xl p-5 sm:p-8">
        <div class="flex items-start justify-between">
            <div>
                <h1 class="page-title">INVOICE</h1>
                <p class="page-subtitle">@_invoice.InvoiceNumber</p>
            </div>
            <div class="text-right">
                <p class="eyebrow">Invoice Date</p>
                <p class="text-sm font-semibold text-slate-900">@_invoice.InvoiceDate.ToString("MMM dd, yyyy")</p>
                <p class="eyebrow mt-2">Due Date</p>
                <p class="text-sm font-semibold @(_invoice.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "text-red-600" : "text-slate-900")">@_invoice.DueDate.ToString("MMM dd, yyyy")</p>
            </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-lg bg-slate-50 p-4">
                <p class="eyebrow">From</p>
                <p class="mt-1 font-semibold text-slate-900">@_invoice.Sender.Name</p>
                @if (!string.IsNullOrWhiteSpace(_invoice.Sender.ContactPerson))
                {
                    <p class="text-sm text-slate-600">@_invoice.Sender.ContactPerson</p>
                }
                <p class="text-sm text-slate-600">@_invoice.Sender.Address</p>
                @if (!string.IsNullOrWhiteSpace(_invoice.Sender.VatId))
                {
                    <p class="mt-2 text-xs text-slate-500">VAT/Tax ID: @_invoice.Sender.VatId</p>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.Sender.Iban))
                {
                    <p class="text-xs text-slate-500">IBAN: @_invoice.Sender.Iban</p>
                }
            </div>
            <div class="rounded-lg bg-brand-50 p-4">
                <p class="eyebrow text-brand-600">Bill To</p>
                <p class="mt-1 font-semibold text-slate-900">@_invoice.Customer.Name</p>
                @if (!string.IsNullOrWhiteSpace(_invoice.Customer.ContactPerson))
                {
                    <p class="text-sm text-slate-600">@_invoice.Customer.ContactPerson</p>
                }
                <p class="text-sm text-slate-600">@_invoice.Customer.Address</p>
                @if (!string.IsNullOrWhiteSpace(_invoice.Customer.Email))
                {
                    <p class="mt-2 text-xs text-slate-500">Email: @_invoice.Customer.Email</p>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.Customer.VatId))
                {
                    <p class="text-xs text-slate-500">VAT/Tax ID: @_invoice.Customer.VatId</p>
                }
            </div>
        </div>

        <div class="mt-6 overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50">
                        <th class="eyebrow rounded-l-lg px-3 py-2.5 text-left text-slate-500">Item Description</th>
                        <th class="eyebrow px-3 py-2.5 text-right text-slate-500">Quantity</th>
                        <th class="eyebrow px-3 py-2.5 text-right text-slate-500">Unit Price</th>
                        <th class="eyebrow rounded-r-lg px-3 py-2.5 text-right text-slate-500">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _invoice.LineItems)
                    {
                        <tr class="border-b border-slate-100">
                            <td class="px-3 py-2 text-slate-700">@item.Description</td>
                            <td class="px-3 py-2 text-right whitespace-nowrap text-slate-600">@item.Quantity.ToString("N2")</td>
                            <td class="px-3 py-2 text-right whitespace-nowrap text-slate-600">@item.UnitPrice.ToString("N2") @_invoice.Currency</td>
                            <td class="px-3 py-2 text-right font-medium whitespace-nowrap text-slate-800">@item.LineTotal.ToString("N2") @_invoice.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 flex justify-end">
            <div class="w-full rounded-lg bg-slate-50 p-4 text-sm sm:w-64">
                <div class="flex justify-between py-1">
                    <span class="text-slate-500">Subtotal</span>
                    <span class="font-medium text-slate-800">@_invoice.Subtotal.ToString("N2") @_invoice.Currency</span>
                </div>
                <div class="flex justify-between py-1">
                    <span class="text-slate-500">Tax (@_invoice.TaxRate.ToString("N2")%)</span>
                    <span class="font-medium text-slate-800">@_invoice.TaxAmount.ToString("N2") @_invoice.Currency</span>
                </div>
                <div class="mt-1 flex justify-between border-t border-slate-200 pt-2">
                    <span class="font-semibold text-slate-900">Total Amount</span>
                    <span class="text-lg font-bold text-brand-600">@_invoice.Total.ToString("N2") @_invoice.Currency</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
        {
            <div class="mt-6 rounded-lg border-l-4 border-amber-400 bg-amber-50 p-4">
                <p class="eyebrow text-amber-700">Notes</p>
                <p class="mt-1 text-sm text-amber-800">@_invoice.Notes</p>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Invoice? _invoice;

    protected override async Task OnInitializedAsync()
    {
        _invoice = await InvoiceSvc.GetAsync(Id);
        if (_invoice is null)
        {
            Nav.NavigateTo("/invoices");
        }
    }
}
