@page "/invoices"
@inject InvoiceService InvoiceSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Invoices · Invoice Builder</PageTitle>

<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="page-title">Invoices</h1>
        <p class="page-subtitle">Create, preview, and download your invoices.</p>
    </div>
    <a href="/invoices/new" class="btn-primary">+ New Invoice</a>
</div>

<div class="card mt-6 overflow-hidden p-2">
    <MudDataGrid Items="@_rows" Dense="true" Hover="true" Loading="@_loading" SortMode="SortMode.Single" Class="ib-grid">
        <Columns>
            <PropertyColumn Property="i => i.InvoiceNumber" Title="Invoice #" />
            <PropertyColumn Property="i => i.Customer.Name" Title="Customer" />
            <PropertyColumn Property="i => i.InvoiceDate" Title="Date" Format="MMM dd, yyyy" />
            <TemplateColumn Title="Due" SortBy="i => i.DueDate">
                <CellTemplate>
                    <div class="flex items-center gap-2">
                        <span>@context.Item.DueDate.ToString("MMM dd, yyyy")</span>
                        @if (context.Item.DueDate < DateOnly.FromDateTime(DateTime.Today))
                        {
                            <span class="badge badge-red">Overdue</span>
                        }
                        else if (context.Item.DueDate <= DateOnly.FromDateTime(DateTime.Today).AddDays(7))
                        {
                            <span class="badge badge-amber">Due soon</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Total" Sortable="false">
                <CellTemplate>
                    <span class="font-semibold text-slate-900">@context.Item.Total.ToString("N2") <span class="text-xs font-medium text-slate-400">@context.Item.Currency</span></span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    <div class="flex items-center justify-end gap-1">
                        <a href="@($"/invoices/{context.Item.Id}")" title="View" class="rounded-lg p-1.5 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        </a>
                        <a href="@($"/invoices/{context.Item.Id}/edit")" title="Edit" class="rounded-lg p-1.5 text-brand-600 transition hover:bg-brand-50 hover:text-brand-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </a>
                        <a href="@($"/invoices/{context.Item.Id}/pdf")" target="_blank" title="Download PDF" class="rounded-lg p-1.5 text-sky-600 transition hover:bg-sky-50 hover:text-sky-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                            </svg>
                        </a>
                        <button type="button" @onclick="() => Delete(context.Item)" title="Delete" class="rounded-lg p-1.5 text-red-500 transition hover:bg-red-50 hover:text-red-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Invoice" />
        </PagerContent>
        <NoRecordsContent>
            <div class="empty-state">
                <p class="empty-state-title">No invoices yet</p>
                <p class="empty-state-hint">Create your first invoice to get started.</p>
                <a href="/invoices/new" class="btn-primary mt-4">+ New Invoice</a>
            </div>
        </NoRecordsContent>
    </MudDataGrid>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private List<Invoice> _rows = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _rows = await InvoiceSvc.GetAllAsync();
        _loading = false;
    }

    private async Task Delete(Invoice invoice)
    {
        var confirmed = await _confirm.ShowAsync(
            $"Remove invoice \"{invoice.InvoiceNumber}\"? This can't be undone.",
            title: "Delete invoice?", confirmText: "Delete");

        if (confirmed)
        {
            try
            {
                await InvoiceSvc.DeleteAsync(invoice.Id);
                Snackbar.Add("Invoice deleted", Severity.Success);
                await Reload();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not delete: {ex.Message}", Severity.Error);
            }
        }
    }
}
