@page "/invoices/new"
@page "/invoices/{Id:int}/edit"
@inject InvoiceService InvoiceSvc
@inject DraftInvoiceHandoff Handoff
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(Id is null ? "New Invoice" : "Edit Invoice") · Invoice Builder</PageTitle>

<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="page-title">@(Id is null ? "New Invoice" : "Edit Invoice")</h1>
        <p class="page-subtitle">Provide invoice details, select a customer and sender, and add line items.</p>
    </div>
    <div class="flex gap-3">
        <a href="/invoices" class="btn-secondary">Cancel</a>
        <button type="submit" form="invoice-form" class="btn-primary" disabled="@_saving">
            @(Id is null ? "Create Invoice" : "Save Changes")
        </button>
    </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        <EditForm id="invoice-form" Model="_model" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            <div class="card p-6">
                <h3 class="card-title">Invoice details</h3>
                <div class="mt-4 space-y-4">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label class="form-label" for="inv-number">Invoice Number</label>
                            <input id="inv-number" value="@_model.InvoiceNumber" disabled="@(Id is null)" placeholder="e.g. INV-2026-014" class="form-input disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500" />
                            <ValidationMessage For="() => _model.InvoiceNumber" class="form-error" />
                        </div>
                        <div>
                            <label class="form-label" for="inv-currency">Currency</label>
                            <select id="inv-currency" @bind="_model.Currency" class="form-input">
                                @foreach (var currency in _currencies)
                                {
                                    <option value="@currency">@currency</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label class="form-label" for="inv-date">Invoice Date</label>
                            <InputDate id="inv-date" TValue="DateOnly" @bind-Value="_model.InvoiceDate" @bind-Value:after="StateHasChanged" class="form-input" />
                        </div>
                        <div>
                            <label class="form-label" for="inv-due">Due Date</label>
                            <InputDate id="inv-due" TValue="DateOnly" @bind-Value="_model.DueDate" @bind-Value:after="StateHasChanged" class="form-input" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label class="form-label" for="inv-customer">Customer</label>
                            <select id="inv-customer" @bind="_model.CustomerId" class="form-input">
                                <option value="0" disabled>Pick a customer…</option>
                                @foreach (var c in _customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <ValidationMessage For="() => _model.CustomerId" class="form-error" />
                        </div>
                        <div>
                            <label class="form-label" for="inv-sender">Sender</label>
                            <select id="inv-sender" @bind="_model.SenderId" class="form-input">
                                <option value="0" disabled>Pick a sender…</option>
                                @foreach (var s in _senders)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <ValidationMessage For="() => _model.SenderId" class="form-error" />
                        </div>
                    </div>

                    <div class="w-44">
                        <label class="form-label">Tax Rate (%)</label>
                        <MudNumericField T="decimal" @bind-Value="_model.TaxRate" @bind-Value:after="StateHasChanged"
                                         Min="0" Max="100" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ib-field mt-1.5" />
                    </div>

                    <div>
                        <label class="form-label" for="inv-notes">Notes</label>
                        <textarea id="inv-notes" @bind="_model.Notes" @bind:event="oninput" rows="2" placeholder="Payment terms, thank-you note…" class="form-input"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mt-6 p-6">
                <div class="flex items-center justify-between">
                    <h3 class="card-title">Line items</h3>
                    <button type="button" @onclick="AddItem" class="btn-secondary px-3 py-1.5">+ Add Item</button>
                </div>

                @if (_model.LineItems.Count > 0)
                {
                    <div class="eyebrow mt-4 hidden items-center gap-3 sm:flex">
                        <span class="flex-1">Description</span>
                        <span class="w-24 text-right">Qty</span>
                        <span class="w-28 text-right">Unit Price</span>
                        <span class="w-28 text-right">Total</span>
                        <span class="w-14"></span>
                    </div>
                }

                <div class="mt-2 space-y-3">
                    @foreach (var item in _model.LineItems)
                    {
                        <LineItemRow @key="item" Item="item" OnRemove="() => RemoveItem(item)" OnChanged="StateHasChanged" />
                    }
                    @if (_model.LineItems.Count == 0)
                    {
                        <div class="empty-state rounded-xl border border-dashed border-slate-300 py-8">
                            <p class="empty-state-hint mt-0">No line items yet — add your first one.</p>
                            <button type="button" @onclick="AddItem" class="btn-secondary mt-3 px-3 py-1.5">+ Add Item</button>
                        </div>
                    }
                </div>
            </div>
        </EditForm>
    </div>

    <div class="lg:col-span-1">
        <div class="sticky top-24">
            <InvoiceSummary Invoice="_model" />
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private Invoice _model = new();
    private List<Customer> _customers = new();
    private List<Sender> _senders = new();
    private bool _saving;
    private static readonly string[] _currencies = ["USD", "EUR", "GBP", "CHF", "AUD", "CAD", "INR", "NPR", "JPY"];

    protected override async Task OnInitializedAsync()
    {
        _customers = await InvoiceSvc.GetCustomersAsync();
        _senders = await InvoiceSvc.GetSendersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is int id)
        {
            _model = await InvoiceSvc.GetAsync(id) ?? new();
        }
        else
        {
            if (string.IsNullOrEmpty(_model.InvoiceNumber))
            {
                _model.InvoiceNumber = await InvoiceSvc.GetNextInvoiceNumberAsync();
            }

            if (Handoff.TakePending() is { } draft)
            {
                ApplyDraft(draft);
            }
        }

        if (string.IsNullOrWhiteSpace(_model.Currency) || !_currencies.Contains(_model.Currency))
        {
            _model.Currency = _currencies[0];
        }
    }

    // Prefills a new invoice from an AI-generated draft (Modules/AiInvoiceDrafting). Nothing
    // is saved here — the user still reviews/edits and submits via the normal Save flow below.
    // If the AI's customer name doesn't match an existing customer, the dropdown is left
    // unset so the user must explicitly pick or go create one — the draft never auto-creates.
    private void ApplyDraft(DraftInvoiceResult draft)
    {
        var matched = _customers.FirstOrDefault(
            c => string.Equals(c.Name, draft.CustomerName, StringComparison.OrdinalIgnoreCase));

        if (matched is not null)
        {
            _model.CustomerId = matched.Id;
        }
        else if (!string.IsNullOrWhiteSpace(draft.CustomerName))
        {
            Snackbar.Add($"No existing customer matches \"{draft.CustomerName}\" — pick or create one below.", Severity.Warning);
        }

        if (draft.InvoiceDate is { } invoiceDate) _model.InvoiceDate = invoiceDate;
        if (draft.DueDate is { } dueDate) _model.DueDate = dueDate;
        _model.TaxRate = draft.TaxRate;
        if (!string.IsNullOrWhiteSpace(draft.Notes)) _model.Notes = draft.Notes;

        _model.LineItems = draft.LineItems
            .Select(li => new InvoiceLineItem { Description = li.Description, Quantity = li.Quantity, UnitPrice = li.UnitPrice })
            .ToList();

        Snackbar.Add("AI draft loaded — review before saving.", Severity.Info);
    }

    private void AddItem() => _model.LineItems.Add(new InvoiceLineItem { Quantity = 1 });

    private void RemoveItem(InvoiceLineItem item) => _model.LineItems.Remove(item);

    private async Task Save()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            if (_model.Id == 0)
                await InvoiceSvc.CreateAsync(_model);
            else
                await InvoiceSvc.UpdateAsync(_model);

            Snackbar.Add("Invoice saved", Severity.Success);
            Nav.NavigateTo("/invoices");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
