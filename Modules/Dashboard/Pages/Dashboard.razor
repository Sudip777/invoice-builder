@page "/dashboard"
@inject DashboardService DashboardSvc

<PageTitle>Dashboard · Invoice Builder</PageTitle>

<div class="flex items-center justify-between gap-4">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">An overview of your invoicing activity.</p>
    </div>
    <a href="/invoices/new" class="btn-primary shrink-0">+ New Invoice</a>
</div>

@if (_data is null)
{
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="card flex animate-pulse items-center gap-4 p-5">
                <div class="h-11 w-11 shrink-0 rounded-xl bg-slate-100"></div>
                <div class="space-y-2">
                    <div class="h-3 w-24 rounded bg-slate-100"></div>
                    <div class="h-6 w-14 rounded bg-slate-100"></div>
                </div>
            </div>
        }
    </div>
    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="card h-80 animate-pulse lg:col-span-2"></div>
        <div class="card h-80 animate-pulse"></div>
    </div>
}
else
{
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard Label="Invoices" Value="@_data.InvoiceCount.ToString()" Href="/invoices" Tint="bg-brand-50 text-brand-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
            </Icon>
        </StatCard>
        <StatCard Label="Customers" Value="@_data.CustomerCount.ToString()" Href="/customers" Tint="bg-sky-50 text-sky-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                </svg>
            </Icon>
        </StatCard>
        <StatCard Label="Senders" Value="@_data.SenderCount.ToString()" Href="/senders" Tint="bg-slate-100 text-slate-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                </svg>
            </Icon>
        </StatCard>
        <StatCard Label="Total Outstanding" Value="@_data.TotalOutstanding.ToString("N0")" Href="/invoices" Tint="bg-emerald-50 text-emerald-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 3.75v-.75A.75.75 0 0 0 3 17.25h-.75m17.25-4.5a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-9.75 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
            </Icon>
        </StatCard>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="card p-6 lg:col-span-2">
            <h3 class="card-title">Revenue — last 6 months</h3>
            @if (_data.MonthlyRevenue.All(m => m.Total == 0))
            {
                <div class="empty-state">
                    <p class="empty-state-title">No invoice activity yet</p>
                    <p class="empty-state-hint">Revenue will chart here once invoices have dates in range.</p>
                </div>
            }
            else
            {
                <div class="ib-chart mt-4">
                    <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_revenueSeries" ChartLabels="@_revenueLabels"
                              ChartOptions="@_lineOptions" Width="100%" Height="280px" />
                </div>
            }
        </div>

        <div class="card p-6">
            <h3 class="card-title">Invoice status</h3>
            @if (_data.InvoiceCount == 0)
            {
                <div class="empty-state">
                    <p class="empty-state-title">No invoices yet</p>
                </div>
            }
            else
            {
                <div class="ib-chart mt-4">
                    <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_statusSeries" ChartLabels="@_statusLabels"
                              ChartOptions="@_donutOptions" Width="100%" Height="220px" />
                </div>
                <div class="mt-4 space-y-2 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>Overdue</span>
                        <span class="font-medium text-slate-900">@_data.OverdueCount</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>Due soon</span>
                        <span class="font-medium text-slate-900">@_data.DueSoonCount</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-brand-500"></span>Upcoming</span>
                        <span class="font-medium text-slate-900">@_data.UpcomingCount</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mt-6 overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
            <h3 class="card-title">Recent invoices</h3>
            <a href="/invoices" class="row-action text-brand-600 hover:text-brand-500">View all</a>
        </div>
        @if (_data.RecentInvoices.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-state-title">No invoices yet</p>
                <a href="/invoices/new" class="btn-primary mt-4">+ New Invoice</a>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var invoice in _data.RecentInvoices)
                {
                    <a href="@($"/invoices/{invoice.Id}")" class="flex items-center justify-between gap-4 px-5 py-3 transition hover:bg-slate-50">
                        <div class="min-w-0">
                            <p class="truncate text-sm font-medium text-slate-900">@invoice.InvoiceNumber</p>
                            <p class="truncate text-xs text-slate-500">@invoice.Customer.Name</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <span class="@($"badge hidden sm:inline-flex {DueBadgeClass(invoice)}")">@DueBadgeText(invoice)</span>
                            <span class="text-sm font-semibold text-slate-900">@invoice.Total.ToString("N2") <span class="text-xs font-medium text-slate-400">@invoice.Currency</span></span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private DashboardData? _data;
    private List<ChartSeries<double>> _revenueSeries = new();
    private string[] _revenueLabels = [];
    private List<ChartSeries<double>> _statusSeries = new();
    private string[] _statusLabels = [];

    // brand-600 for the revenue line; red/amber/brand for the status donut, matching the .badge-* colors.
    private static readonly LineChartOptions _lineOptions = new() { ChartPalette = ["#4f46e5"] };
    private static readonly DonutChartOptions _donutOptions = new() { ChartPalette = ["#dc2626", "#d97706", "#4f46e5"] };

    // Same date-derived buckets as DashboardService / the Invoices grid badges.
    private static string DueBadgeClass(Invoice invoice)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (invoice.DueDate < today) return "badge-red";
        if (invoice.DueDate <= today.AddDays(7)) return "badge-amber";
        return "badge-brand";
    }

    private static string DueBadgeText(Invoice invoice)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (invoice.DueDate < today) return "Overdue";
        if (invoice.DueDate <= today.AddDays(7)) return "Due soon";
        return "Upcoming";
    }

    protected override async Task OnInitializedAsync()
    {
        _data = await DashboardSvc.GetAsync();

        _revenueLabels = _data.MonthlyRevenue.Select(m => m.Label).ToArray();
        _revenueSeries = new List<ChartSeries<double>>
        {
            new() { Name = "Revenue", Data = _data.MonthlyRevenue.Select(m => (double)m.Total).ToArray() },
        };

        double[] statusData = [_data.OverdueCount, _data.DueSoonCount, _data.UpcomingCount];
        _statusSeries = statusData.AsChartDataSet();
        _statusLabels = ["Overdue", "Due soon", "Upcoming"];
    }
}
