@page "/customers/new"
@page "/customers/{Id:int}/edit"
@inject CustomerService Customers
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(Id is null ? "New Customer" : "Edit Customer") · Invoice Builder</PageTitle>

<div class="mx-auto max-w-2xl">
    <a href="/customers" class="back-link">&larr; Back to Customers</a>
    <h1 class="page-title mt-3">@(Id is null ? "New Customer" : "Edit Customer")</h1>
    <p class="page-subtitle">Details used as the "Bill To" block on your invoices.</p>

    <EditForm Model="_model" OnValidSubmit="Save" class="card mt-6 space-y-4 p-6">
        <DataAnnotationsValidator />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label class="form-label" for="cust-name">Name</label>
                <input id="cust-name" @bind="_model.Name" @bind:event="oninput" placeholder="e.g. ACME Corp" class="form-input" />
                <ValidationMessage For="() => _model.Name" class="form-error" />
            </div>
            <div>
                <label class="form-label" for="cust-contact">Contact Person</label>
                <input id="cust-contact" @bind="_model.ContactPerson" @bind:event="oninput" placeholder="e.g. John Doe" class="form-input" />
            </div>
        </div>

        <div>
            <label class="form-label" for="cust-address">Address</label>
            <textarea id="cust-address" @bind="_model.Address" @bind:event="oninput" rows="2" placeholder="Street, city, postal code" class="form-input"></textarea>
            <ValidationMessage For="() => _model.Address" class="form-error" />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label class="form-label" for="cust-email">Email</label>
                <input id="cust-email" type="email" @bind="_model.Email" @bind:event="oninput" placeholder="billing@acme.com" class="form-input" />
                <ValidationMessage For="() => _model.Email" class="form-error" />
            </div>
            <div>
                <label class="form-label" for="cust-vat">VAT / Tax ID</label>
                <input id="cust-vat" @bind="_model.VatId" @bind:event="oninput" class="form-input" />
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-100 pt-4">
            <a href="/customers" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary" disabled="@_saving">Save Customer</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private Customer _model = new();
    private bool _saving;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is int id)
        {
            _model = await Customers.GetAsync(id) ?? new();
        }
    }

    private async Task Save()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            if (_model.Id == 0)
                await Customers.CreateAsync(_model);
            else
                await Customers.UpdateAsync(_model);

            Snackbar.Add("Customer saved", Severity.Success);
            Nav.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
