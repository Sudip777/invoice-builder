@page "/customers"
@inject CustomerService CustomerSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Customers · Invoice Builder</PageTitle>

<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="page-title">Customers</h1>
        <p class="page-subtitle">The people and companies you bill.</p>
    </div>
    <a href="/customers/new" class="btn-primary">+ New Customer</a>
</div>

<div class="card mt-6 overflow-hidden p-2">
    <MudDataGrid Items="@_rows" Dense="true" Hover="true" Loading="@_loading" SortMode="SortMode.Single" Class="ib-grid">
        <Columns>
            <PropertyColumn Property="c => c.Name" Title="Name" />
            <PropertyColumn Property="c => c.ContactPerson" Title="Contact" />
            <PropertyColumn Property="c => c.Email" Title="Email" />
            <PropertyColumn Property="c => c.VatId" Title="VAT / Tax ID" />
            <TemplateColumn T="Customer" Title="Actions" Sortable="false">
                <CellTemplate Context="context">
                    <div class="flex justify-end gap-1">
                        <a href="@($"/customers/{context.Item.Id}/edit")" title="Edit" class="rounded-lg p-1.5 text-brand-600 transition hover:bg-brand-50 hover:text-brand-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </a>
                        <button type="button" @onclick="() => Delete(context.Item)" title="Delete" class="rounded-lg p-1.5 text-red-500 transition hover:bg-red-50 hover:text-red-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Customer" />
        </PagerContent>
        <NoRecordsContent>
            <div class="empty-state">
                <p class="empty-state-title">No customers yet</p>
                <p class="empty-state-hint">Add the first person or company you bill.</p>
                <a href="/customers/new" class="btn-primary mt-4">+ New Customer</a>
            </div>
        </NoRecordsContent>
    </MudDataGrid>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private List<Customer> _rows = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _rows = await CustomerSvc.GetAllAsync();
        _loading = false;
    }

    private async Task Delete(Customer customer)
    {
        var confirmed = await _confirm.ShowAsync(
            $"Remove \"{customer.Name}\"? This can't be undone.",
            title: "Delete customer?", confirmText: "Delete");

        if (confirmed)
        {
            try
            {
                await CustomerSvc.DeleteAsync(customer.Id);
                Snackbar.Add("Customer deleted", Severity.Success);
                await Reload();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not delete: {ex.Message}", Severity.Error);
            }
        }
    }
}
