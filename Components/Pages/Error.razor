@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Invoice Builder</PageTitle>

<div class="mx-auto max-w-2xl">
    <span class="badge badge-red">Error</span>
    <h1 class="page-title mt-3">Something went wrong.</h1>
    <p class="page-subtitle">An error occurred while processing your request. Try again, or head back home.</p>

    @if (ShowRequestId)
    {
        <div class="card mt-6 p-6">
            <p class="eyebrow">Request ID</p>
            <code class="mt-1 block font-mono text-sm text-slate-700">@RequestId</code>
            <p class="mt-3 text-xs text-slate-400">
                Share this ID with your administrator to help track down the error.
                Detailed error information is only shown when the app runs in the
                <strong>Development</strong> environment.
            </p>
        </div>
    }

    <div class="mt-6 flex gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/invoices" class="btn-secondary">Go to invoices</a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
