@page "/"

<PageTitle>Invoice Builder</PageTitle>

<div class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 flex justify-center">
        <div class="h-96 w-[36rem] -translate-y-24 rounded-full bg-brand-200/40 blur-3xl"></div>
        <div class="h-96 w-[36rem] -translate-y-40 translate-x-40 rounded-full bg-violet-200/40 blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-3xl pt-6 text-center">
        <span class="badge badge-brand mx-auto">Free &amp; simple invoicing</span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
            Professional invoices,<br />
            <span class="bg-gradient-to-r from-brand-600 to-violet-600 bg-clip-text text-transparent">in seconds.</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-base text-slate-500 sm:text-lg">
            Create, manage, and download polished PDF invoices for your business — customers, senders, taxes, and line items all in one place.
        </p>
        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <a href="/invoices/new" class="btn-primary justify-center px-5 py-2.5">Create your first invoice</a>
            <a href="/invoices" class="btn-secondary justify-center px-5 py-2.5">Browse invoices</a>
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-slate-500">
            <span>No credit card required</span>
            <span class="text-slate-300">&middot;</span>
            <span>Export to PDF</span>
            <span class="text-slate-300">&middot;</span>
            <span>Unlimited invoices</span>
        </div>
    </div>

    <div class="mx-auto mt-10 max-w-3xl sm:mt-12">
        <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xl ring-1 ring-slate-900/5">
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-4 sm:p-6">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Invoice</p>
                        <p class="mt-1 text-lg font-bold text-slate-900">#INV-1042</p>
                    </div>
                    <span class="badge badge-green">Paid</span>
                </div>
                <div class="mt-5 grid grid-cols-2 gap-4 text-left text-sm">
                    <div>
                        <p class="text-xs font-medium text-slate-400">Billed to</p>
                        <p class="mt-0.5 font-medium text-slate-700">Acme Studio LLC</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-medium text-slate-400">Due date</p>
                        <p class="mt-0.5 font-medium text-slate-700">Aug 15, 2026</p>
                    </div>
                </div>
                <div class="mt-5 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
                    <div class="flex items-center justify-between px-4 py-2.5 text-sm">
                        <span class="text-slate-600">Brand identity design</span>
                        <span class="font-medium text-slate-900">$1,800.00</span>
                    </div>
                    <div class="flex items-center justify-between px-4 py-2.5 text-sm">
                        <span class="text-slate-600">Website development</span>
                        <span class="font-medium text-slate-900">$3,200.00</span>
                    </div>
                    <div class="flex items-center justify-between px-4 py-2.5 text-sm">
                        <span class="text-slate-600">Monthly support retainer</span>
                        <span class="font-medium text-slate-900">$450.00</span>
                    </div>
                </div>
                <div class="mt-3 flex items-center justify-end gap-2 text-sm">
                    <span class="text-slate-500">Total due</span>
                    <span class="text-lg font-extrabold text-slate-900">$5,450.00</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mx-auto mt-20 max-w-2xl text-center">
    <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">Everything you need</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">One place to run your billing</h2>
</div>

<div class="mx-auto mt-8 grid max-w-5xl grid-cols-1 gap-5 sm:grid-cols-3">
    <a href="/invoices" class="card group p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Invoices</h3>
        <p class="mt-1 text-sm text-slate-500">Create, preview, and download PDF invoices.</p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-600">Open <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span></span>
    </a>

    <a href="/customers" class="card group p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-600 transition group-hover:bg-sky-600 group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Customers</h3>
        <p class="mt-1 text-sm text-slate-500">Manage the people and companies you bill.</p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-sky-600">Open <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span></span>
    </a>

    <a href="/senders" class="card group p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-md">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 transition group-hover:bg-emerald-600 group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
            </svg>
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Senders</h3>
        <p class="mt-1 text-sm text-slate-500">Manage the businesses you bill from.</p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-emerald-600">Open <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span></span>
    </a>
</div>
