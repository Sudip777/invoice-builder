@implements IDisposable
@inject NavigationManager Nav

@* Off-canvas on mobile/tablet (< lg), fixed-open rail on lg+. _open is real
   Blazor state (not a CSS-only checkbox) so navigating to a page — which
   doesn't re-render this layout component's markup by itself — still closes
   the drawer via the LocationChanged subscription below. *@
@if (_open)
{
    <div class="fixed inset-0 z-30 bg-slate-900/40 lg:hidden" @onclick="Close" aria-hidden="true"></div>
}

<header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-slate-200/80 bg-white/85 px-4 shadow-sm backdrop-blur sm:px-6 lg:hidden">
    <button type="button" @onclick="Open" class="-ml-1.5 flex h-9 w-9 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" /></svg>
    </button>
    <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5">
        <span class="brand-mark">IB</span>
        <span class="text-lg font-bold tracking-tight text-slate-900">Invoice<span class="text-brand-600">Builder</span></span>
    </NavLink>
</header>

<aside class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col border-r border-slate-200 bg-white transition-transform duration-200 @(_open ? "translate-x-0" : "-translate-x-full") lg:translate-x-0">
    <div class="flex h-16 shrink-0 items-center gap-2.5 border-b border-slate-100 px-5">
        <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5">
            <span class="brand-mark">IB</span>
            <span class="text-lg font-bold tracking-tight text-slate-900">Invoice<span class="text-brand-600">Builder</span></span>
        </NavLink>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
        <NavLink href="dashboard" class="sidebar-link">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5M3.75 3h16.5M21.75 3h-1.5m0 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3.75m8.5-3.75 1 3.75m-9.5 0h9.5" /></svg>
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="invoices" class="sidebar-link">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
            <span>Invoices</span>
        </NavLink>
        <NavLink href="customers" class="sidebar-link">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
            <span>Customers</span>
        </NavLink>
        <NavLink href="senders" class="sidebar-link">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
            <span>Senders</span>
        </NavLink>
    </nav>

    <div class="shrink-0 border-t border-slate-100 p-3">
        <AuthorizeView>
            <Authorized>
                <details class="group relative">
                    <summary class="flex list-none items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-semibold text-brand-700">
                            @Initials(DisplayName(context))
                        </span>
                        <span class="min-w-0 flex-1 truncate text-left">@DisplayName(context)</span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-slate-400 transition group-open:rotate-180"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
                    </summary>

                    <div class="absolute bottom-full left-0 z-30 mb-2 w-full overflow-hidden rounded-xl border border-slate-200 bg-white py-1.5 shadow-lg">
                        <div class="border-b border-slate-100 px-3.5 py-2.5">
                            <p class="truncate text-sm font-semibold text-slate-900">@DisplayName(context)</p>
                            <p class="truncate text-xs text-slate-500">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</p>
                        </div>
                        <form method="post" action="Account/Logout">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/login" />
                            <button type="submit" class="flex w-full items-center gap-2 px-3.5 py-2 text-left text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-red-600">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z" clip-rule="evenodd" /><path fill-rule="evenodd" d="M6 10a.75.75 0 0 1 .75-.75h9.19l-2.72-2.72a.75.75 0 1 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06l2.72-2.72H6.75A.75.75 0 0 1 6 10Z" clip-rule="evenodd" /></svg>
                                Logout
                            </button>
                        </form>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    private bool _open;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_open) return;
        _open = false;
        InvokeAsync(StateHasChanged);
    }

    private void Open() => _open = true;
    private void Close() => _open = false;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private static string DisplayName(AuthenticationState context)
        => context.User.FindFirst("display_name")?.Value
           ?? context.User.Identity?.Name
           ?? "Account";

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
