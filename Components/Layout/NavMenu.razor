<header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/85 shadow-sm backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5">
            <span class="brand-mark">IB</span>
            <span class="text-lg font-bold tracking-tight text-slate-900">Invoice<span class="text-brand-600">Builder</span></span>
        </NavLink>

        <nav class="flex items-center gap-5 sm:gap-7">
            <NavLink href="invoices" class="nav-link">Invoices</NavLink>
            <NavLink href="customers" class="nav-link">Customers</NavLink>
            <NavLink href="senders" class="nav-link">Senders</NavLink>
        </nav>

        <div class="flex items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <details class="group relative">
                        <summary class="flex list-none items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
                            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-xs font-semibold text-brand-700">
                                @Initials(DisplayName(context))
                            </span>
                            <span class="hidden max-w-[10rem] truncate sm:inline">@DisplayName(context)</span>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-slate-400 transition group-open:rotate-180"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
                        </summary>

                        <div class="absolute right-0 z-30 mt-2 w-56 overflow-hidden rounded-xl border border-slate-200 bg-white py-1.5 shadow-lg">
                            <div class="border-b border-slate-100 px-3.5 py-2.5">
                                <p class="truncate text-sm font-semibold text-slate-900">@DisplayName(context)</p>
                                <p class="truncate text-xs text-slate-500">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</p>
                            </div>
                            <form method="post" action="Account/Logout">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="/login" />
                                <button type="submit" class="flex w-full items-center gap-2 px-3.5 py-2 text-left text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-red-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z" clip-rule="evenodd" /><path fill-rule="evenodd" d="M6 10a.75.75 0 0 1 .75-.75h9.19l-2.72-2.72a.75.75 0 1 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06l2.72-2.72H6.75A.75.75 0 0 1 6 10Z" clip-rule="evenodd" /></svg>
                                    Logout
                                </button>
                            </form>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private static string DisplayName(AuthenticationState context)
        => context.User.FindFirst("display_name")?.Value
           ?? context.User.Identity?.Name
           ?? "Account";

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant(),
        };
    }
}
