@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="flex min-h-screen flex-col bg-slate-50">
    <NavMenu />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
        @Body
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row sm:px-6">
            <div class="flex items-center gap-2.5">
                <div class="leading-tight">
                    <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2.5">
                        <span
                        class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-sm font-bold text-white shadow-sm">IB</span>
                        <span class="text-lg font-bold tracking-tight text-slate-900">Invoice<span
                            class="text-indigo-600">Builder</span></span>
                        </NavLink>
                        <span class="block text-xs text-slate-400">Create, manage &amp; export invoices.</span>
                    </div>
                </div>
                <p class="text-xs text-slate-400">
                    &copy; @DateTime.Now.Year InvoiceBuilder. All rights reserved.
                </p>
            </div>
        </footer>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
