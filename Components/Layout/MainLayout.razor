@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="flex min-h-screen flex-col bg-slate-50">
    <NavMenu />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
        @Body
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl justify-center px-4 py-6 sm:px-6">
            <p class="text-xs text-slate-400">
                &copy; @DateTime.Now.Year InvoiceBuilder. All rights reserved.
            </p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // MudBlazor palette aligned to the design system in app.css, so Mud-rendered
    // chrome (grid pager, focus states, progress bars) uses the brand colors
    // instead of Material's defaults.
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4f46e5",   // brand-600
            Secondary = "#7c3aed", // violet-600 (gradient companion)
            Info = "#4f46e5",
            Success = "#059669",   // emerald-600
            Warning = "#d97706",   // amber-600
            Error = "#dc2626",     // red-600
        },
    };
}
